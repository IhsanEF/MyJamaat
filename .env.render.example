# Local production-runtime verification. Render supplies PORT and
# RENDER_EXTERNAL_URL automatically; PUBLIC_ORIGIN is an optional override.
PORT=10000
PUBLIC_ORIGIN=http://127.0.0.1:10000
SQLITE_PATH=/absolute/private/path/my-jamaat.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails approved for this pilot.
ALLOWED_SIGN_IN_EMAILS=
